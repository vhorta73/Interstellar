/**
 * @defgroup LoggingExamples Logging
 * @ingroup Examples
 * @brief Quick examples for Logging and fmt helpers.
 * @since 1.0
 *
 * ### Basic usage
 * @code
 * using namespace Interstellar::Logging;
 * logGeneric.LogInfo("Hello {}", "world");
 * @endcode
 *
 * ### Category and level
 * @code
 * Logger net("Network", LogLevel::Warn);
 * net.LogWarn("Latency {} ms", ms);
 * @endcode
 *
 * ### Parsing levels from config
 * @code
 * auto lvl = ParseLogLevelOr(cfg.logLevel, LogLevel::Info);
 * Logger gameplay("Gameplay", lvl);
 * gameplay.LogDebug("Spawned {}", count);
 * @endcode
 *
 * @code
 * #include <optional>
 * #include <fmt/format.h>
 * #include <Interstellar/Logging/OptionalFormatter.hpp>
 *
 * std::optional<int> v1 = 42;
 * std::optional<int> v2 = std::nullopt;
 * fmt::print("v1={} v2={}\n", v1, v2); // v1=42 v2=null
 * @endcode
 */
