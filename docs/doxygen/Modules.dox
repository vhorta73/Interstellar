/** 
* @defgroup Modules Modules
* High-level module groups for the Interstellar project with examples.
*/

/**
* @ingroup Modules
* @defgroup IO IO
* @brief IO utilities: error types, expected shim, filesystem helpers, containers, and file orchestration.
* @since 1.0 
*/

/** 
* @defgroup Input Input
* @ingroup Modules
* @brief Core input module (keyboard, mouse, backends, helpers).
* @since 1.0
*/

 /**
 * @defgroup Units Units
 * @ingroup Modules
 * @brief Strongly-typed SI quantities and physical constants (mp-units).
 * @since 1.0
 */

 /**
 *  @defgroup Graphics Graphics
 *  @ingroup Modules
 *  @brief Interstellar Graphics module (backend-agnostic rendering facade).
 *  @since 1.0
 */
 
 /**
 * @defgroup Renderers Renderers
 * @ingroup Modules
 * @brief Rendering interfaces and backend implementations.
 * @since 1.0
 */
 
 /**
 * @defgroup ECS ECS
 * @ingroup Modules
 * @brief Minimal entity-component slice (Transform, Velocity, World).
 * @since 1.0
 */
 
 /**
 * @defgroup Simulation Simulation
 * @ingroup Modules
 * @brief Rendering interfaces and backend implementations.
 * @since 1.0
 */

 /**
 * @defgroup Logging Logging
 * @ingroup Modules
 * @brief Public logging facilities for the Interstellar codebase.
 * @since 1.0
 */

 /**
 * @defgroup Engine Engine
 * @ingroup Modules
 * @brief Core game engine: fixed-timestep loop, frame timing, cameras, and config.
 * @since 1.0
 */

 /**
 * @defgroup Scenes Scenes
 * @ingroup Modules
 * @brief High-level scene management combining camera, universe rendering, and input.
 * @since 1.0
 */

 /**
 * @defgroup Universe Universe
 * @ingroup Modules
 * @brief Seed-based procedural universe generation, sector streaming, and spatial queries.
 * @since 1.0
 */

