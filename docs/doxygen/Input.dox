/**
 * @defgroup Input Input
 * @ingroup Interstellar
 * @brief Core module for user input (keyboard, mouse).
 *
 * The Input module provides a platform-agnostic API for keyboard and mouse.
 * See \subpage InputExamples for a practical walkthrough.
 */

/**
 * @defgroup KeyCodes Key Codes
 * @ingroup Input
 * @brief Unified keyboard key identifiers and utilities.
 *
 * Includes:
 * - enum class KeyCode
 * - KeyCodeCount()
 */

/**
 * @defgroup MouseButtons Mouse Buttons
 * @ingroup Input
 * @brief Unified mouse button identifiers and utilities.
 *
 * Includes:
 * - enum class MouseButton
 * - MouseButtonCount()
 */

/**
 * @defgroup InputBuildInfo Input Build Information
 * @ingroup Input
 * @brief Build flags and compile-time feature info.
 *
 * Includes:
 * - struct BuildInfo
 * - GetBuildInfo()
 */

/**
 * @defgroup InputHelpers Input Convenience Helpers
 * @ingroup Input
 * @brief Small helper functions and RAII utilities.
 *
 * Includes:
 * - Keyboard helpers: Down, Pressed, Released
 * - Mouse helpers: DeltaNorm, WheelZoom, MouseFilter
 * - Utilities: InputFrameGuard, InputCapture, InputContext, MakeDebug
 */

/**
 * @page InputExamples Input Examples
 *
 * This page shows how to integrate the Input module and query devices.
 *
 * @section ex_include 1) Include umbrella
 * @code
 * #include <Interstellar/Input/Input.hpp>
 * using namespace Interstellar::Input;
 * @endcode
 *
 * @section ex_create 2) Create the input system
 * @code
 * std::unique_ptr<InputSystem> CreateInput(void* windowPtr) {
 *     InputConfig cfg{};
 *     cfg.nativeWindow = windowPtr;                  // e.g. GLFWwindow*
 *     cfg.backend = InputConfig::Backend::Auto;      // or GLFW, Null
 *     cfg.preferPlatformRaw = true;                  // opt-in to raw mouse where supported
 *     auto sys = InputSystem::Create(cfg);
 *     // Optional: log what backend was selected at runtime
 *     // printf("Input backend: %s\n", BackendName(sys->backend()));
 *     return sys;
 * }
 * @endcode
 *
 * @section ex_frame 3) Drive the per-frame lifecycle
 * @code
 * void TickInput(InputSystem& input, double dtSeconds) {
 *     // RAII guard ensures symmetry: pump(), beginFrame(), endFrame()
 *     InputFrameGuard guard(input, dtSeconds);
 *
 *     IKeyboard& kb = input.keyboard();
 *     IMouse&    ms = input.mouse();
 *
 *     if (Pressed(kb, KeyCode::Escape)) {
 *         // handle pause, open menu, etc.
 *     }
 *
 *     // Use mouse deltas (pixels) or normalized deltas
 *     auto dpx = ms.delta();                       // pixels: dpx.dx, dpx.dy
 *     glm::vec2 nd = DeltaNorm(ms, w, h);         // normalized [-1..+1] across window
 * }
 * @endcode
 *
 * @section ex_actions 4) Simple action binding for gameplay
 * @code
 * InputContext ctx;
 * ctx.bind("Jump",  KeyCode::Space);
 * ctx.bind("Shoot", KeyCode::Enter);
 *
 * // In your frame
 * if (ctx.actionPressed(input.keyboard(), "Jump"))  { /* jump */ }
 * if (ctx.actionDown(input.keyboard(), "Shoot"))     { /* hold to fire */ }
 * @endcode
 *
 * @section ex_zoom 5) Mouse wheel to camera zoom
 * @code
 * float zoom = 10.0f;
 * zoom = WheelZoom(input.mouse(), zoom, 0.5f, 0.1f, 5000.0f);
 * @endcode
 *
 * @section ex_relative 6) Temporary relative mode for mouselook
 * @code
 * {
 *     InputCapture capture(input.mouse(), true);  // enable relative mode in this scope
 *     // ... use ms.delta() for mouselook ...
 * } // relative mode automatically restored here
 * @endcode
 *
 * @section ex_smoothing 7) Smooth camera pan
 * @code
 * MouseFilter filter;
 * filter.smoothing = 0.35f; // 0.0 = none, 0.9 = heavy
 *
 * // Each frame
 * glm::vec2 smoothed = filter.apply(input.mouse(), w, h);
 * // use smoothed.x, smoothed.y
 * @endcode
 *
 * @section ex_debug 8) Lightweight debug snapshot
 * @code
 * InputDebug dbg = MakeDebug(*inputSystem, inputSystem->mouse());
 * // dbg.backend, dbg.mouseCaptured, dbg.mousePos, dbg.mouseDelta
 * @endcode
 *
 * @section ex_buildinfo 9) Build-time feature flags
 * @code
 * BuildInfo bi = GetBuildInfo();
 * if (bi.haveGLFW) {
 *     // expose or test GLFW-specific behavior
 * }
 * @endcode
 */
