{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 2 },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    }
  ]
}
